[user]
	name = Ilya Hrytsuk
	email = ilya.hrytsuk@dayforce.com
[alias]
	co = checkout
[core]
	excludesfile = ~/.gitignore
	editor = vim
	autocrlf = input
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[format]
	pretty = %C(yellow)%h%Creset %s %C(red)(%an, %cr)%Creset
